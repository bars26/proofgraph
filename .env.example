# ProofGraph V2 — environment template
# Copy to .env.local (Next.js) and/or use the Hardhat keystore for secrets.
# .env* is gitignored. NEVER commit real keys.

# --- Arc Testnet (public, safe to commit) ---
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002

# --- ERC-8004 registries on Arc Testnet (public, verified Day 1) ---
ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713
ERC8004_VALIDATION_REGISTRY=0x8004Cb1BF31DAf7788923b405b754f57acEB4272

# --- ProofGraph V1 (frozen, do not redeploy) ---
NEXT_PUBLIC_EVIDENCE_REGISTRY_V1=0x865BF22320f07Bf23Dc384e314d29fad8A92B939

# --- ProofGraph V2 (filled after Day 3 deploy) ---
NEXT_PUBLIC_EVIDENCE_REGISTRY_V2=
PROOFGRAPH_AGENT_ID=

# --- Explorer API for historical indexing (public RPC prunes history) ---
ARCSCAN_API_URL=https://testnet.arcscan.app/api

# --- SECRETS: do NOT put the private key here in plaintext. ---
# Preferred: Hardhat 3 encrypted keystore
#   npx hardhat keystore set ARC_PRIVATE_KEY
# The deploy/scripts read ARC_PRIVATE_KEY via configVariable() -> keystore or env.
# If you must use an env var for a throwaway testnet key, put it in .env (gitignored):
# ARC_PRIVATE_KEY=0x...
