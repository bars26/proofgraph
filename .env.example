# ProofGraph — env. Public testnet values only. Copy to .env.local.

ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002

# EvidenceRegistryV2 (Day 3 deploy). The lib also hardcodes this as a fallback.
NEXT_PUBLIC_EVIDENCE_REGISTRY_V2=0x99848Ff9527C38c371D5c892a00677b90387aF4a

# --- x402 payment layer (V2.5) ---
# A DEDICATED, low-value Arc wallet that verifies + settles x402 payments.
# Fund it with a little Arc testnet USDC (gas on Arc is USDC). Unset => payment disabled.
X402_FACILITATOR_PRIVATE_KEY=
# Where paid-query USDC lands. Defaults to the facilitator address.
PROOFGRAPH_X402_PAY_TO=
# Free queries per client per day before x402 kicks in (default 5; set 0 to always charge).
# A request can also force the paid path with `?x402=require` (used by the self-test / demo
# so they pass regardless of this number).
PROOFGRAPH_X402_FREE_PER_DAY=5

# Off-chain evidence base (dev only; prod resolves the stored URIs directly).
# PROOFGRAPH_EVIDENCE_BASE_URL=http://localhost:3100
